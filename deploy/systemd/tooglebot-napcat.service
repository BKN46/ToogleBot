[Unit]
Description=NapCat QQ account for ToogleBot
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/root/ToogleBot
Environment=HOME=/root
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/root/.local/bin
ExecStart=/bin/bash /root/ToogleBot/tools/start_napcat_main.sh
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
KillMode=control-group
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
